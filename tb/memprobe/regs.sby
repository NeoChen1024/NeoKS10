# Proof of the GP0 slave properties of memprobe_regs (regs_formal.sv), and a
# check that the assumptions do not exclude the requests (task cover).
# make formal runs both tasks with a time limit.
[tasks]
prove
cover

[options]
timeout 600
prove: mode prove
cover: mode cover
cover: depth 30

[engines]
prove: abc pdr
cover: smtbmc

[script]
read_verilog -sv -formal regmap_pkg.sv memprobe_regs.sv regs_formal.sv
prep -top regs_formal

[files]
../../rtl/gen/regmap_pkg.sv
../../rtl/memprobe/memprobe_regs.sv
regs_formal.sv
